{
  "name": "fly-umwelt",
  "version": "3.8.0",
  "private": true,
  "type": "module",
  "description": "A static browser Drosophila observatory with bundled BANC whole-CNS data, annotation-resolved peripheral channels, a causal joint loop and disclosed biological approximations.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "wasm:build": "node scripts/build_wasm.mjs",
    "build": "node scripts/build.mjs",
    "build:full": "npm run data:reference && npm run build",
    "docs:check": "node scripts/validate_documentation.mjs",
    "check": "node scripts/validate.mjs",
    "check:banc": "node scripts/validate_banc_pack.mjs",
    "calibration:leg": "node scripts/validate_leg_calibration.mjs",
    "experiments:leg": "node scripts/validate_leg_experiments.mjs --check",
    "experiments:leg:strict": "node scripts/validate_leg_experiments.mjs --check --strict",
    "bridge:leg": "node scripts/validate_front_leg_bridge.mjs --check --strict",
    "body:articulated": "node scripts/validate_articulated_body.mjs --check",
    "body:articulated:write": "node scripts/validate_articulated_body.mjs --write",
    "body:musculoskeletal": "node scripts/validate_musculoskeletal_body.mjs --check",
    "body:musculoskeletal:write": "node scripts/validate_musculoskeletal_body.mjs --write",
    "body:musculoskeletal:zero-safe": "node scripts/validate_musculoskeletal_zero_safe.mjs --check",
    "body:musculoskeletal:zero-safe:write": "node scripts/validate_musculoskeletal_zero_safe.mjs --write",
    "bridge:flymimic-banc": "node scripts/validate_flymimic_banc_bridge.mjs --check",
    "bridge:flymimic-banc:write": "node scripts/validate_flymimic_banc_bridge.mjs --write",
    "body:reconcile": "node scripts/validate_body_reconciliation.mjs --check",
    "body:reconcile:write": "node scripts/validate_body_reconciliation.mjs --write",
    "audit:locomotion": "node scripts/validate_locomotor_competence.mjs --check",
    "competence:locomotion": "node scripts/validate_locomotor_competence.mjs --check --strict",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:strict": "node scripts/smoke.mjs --strict",
    "smoke:full": "node scripts/smoke.mjs --strict --page=/?fullprobe=1",
    "smoke:articulated": "node scripts/smoke.mjs --articulated",
    "smoke:musculoskeletal": "node scripts/smoke.mjs --musculoskeletal",
    "fixture": "node scripts/run_python.mjs scripts/build_fixture.py",
    "validate": "npm run docs:check && npm run fixture && npm run check && npm run check:banc && npm run calibration:leg && npm run experiments:leg && npm run bridge:leg && npm run body:articulated && npm run body:musculoskeletal && npm run body:musculoskeletal:zero-safe && npm run bridge:flymimic-banc && npm run body:reconcile && npm run audit:locomotion && npm test && npm run build && npm run smoke:articulated && npm run smoke:musculoskeletal",
    "validate:full": "npm run data:reference && npm run validate && npm run stress",
    "benchmark": "node scripts/benchmark.mjs",
    "stress": "node scripts/stress.mjs",
    "data:reference": "node scripts/ensure_reference_data.mjs",
    "data:fafb": "node scripts/run_python.mjs scripts/build_codex_fafb_pack.py",
    "data:banc": "node scripts/run_python.mjs scripts/build_banc_pack.py",
    "data:banc:strict": "node scripts/run_python.mjs scripts/build_banc_pack.py --strict-known-source",
    "data:morphology": "node scripts/vendor_neuromechfly_browser_assets.mjs",
    "data:musculoskeletal": "node scripts/vendor_flymimic_musculoskeletal_assets.mjs",
    "release:manifest": "node scripts/release_manifest.mjs",
    "behavior": "node scripts/behavior_panel.mjs",
    "banc:dynamics": "node scripts/banc_dynamics.mjs",
    "preview:visual": "node scripts/visual_preview.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
